root = true

[*]
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.{cpp,h,in}]
curly_bracket_next_line = true
indent_brace_style = Allman

[*.{vcxproj,vcxproj.filters,proj,nativeproj,locproj}]
indent_size = 2

[*.builds]
indent_size = 2

[*.{resx,ruleset,slnx,stylecop,xml}]
indent_size = 2

[*.resx]
insert_final_newline = false
trim_trailing_whitespace = false

[*.{props,targets,config,nuspec}]
indent_size = 2

[*.{json,yaml,yml}]
indent_size = 2

[*.sh]
end_of_line = lf

[*.{cmd,bat}]
end_of_line = crlf
