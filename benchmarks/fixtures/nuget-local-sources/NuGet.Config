<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="flat" value="feeds/flat" />
    <add key="hierarchical" value="feeds/hierarchical" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="flat">
      <package pattern="Newtonsoft.*" />
    </packageSource>
    <packageSource key="hierarchical">
      <package pattern="Humanizer.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
