<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="policy" value="https://packages.example.test/v3/index.json" protocolVersion="3" />
  </packageSources>
  <config>
    <add key="http_proxy" value="http://proxy.example.test:8080" />
    <add key="no_proxy" value="localhost,.example.test" />
    <add key="maxHttpRequestsPerSource" value="7" />
  </config>
</configuration>
