<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="decoy" value="https://www.nuget.org/api/v2" protocolVersion="2" />
    <add key="selected" value="https://www.nuget.org/api/v2" protocolVersion="2" />
    <add key="legacy" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <auditSources>
    <clear />
    <add key="machine-audit" value="https://www.nuget.org/api/v2" protocolVersion="2" />
  </auditSources>
  <packageSourceMapping>
    <packageSource key="decoy">
      <package pattern="Decoy.*" />
    </packageSource>
    <packageSource key="selected">
      <package pattern="Old.*" />
    </packageSource>
    <packageSource key="internal">
      <package pattern="Company.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
