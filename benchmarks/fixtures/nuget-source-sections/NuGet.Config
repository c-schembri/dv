<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <clear />
    <add key="globalPackagesFolder" value="%DV_CONFIG_PACKAGES%" />
  </config>
  <packageSources>
    <add key="selected" value="%DV_CONFIG_SOURCE%" protocolVersion="3" />
    <add key="legacy" value="https://www.nuget.org/api/v2" protocolVersion="2" />
  </packageSources>
  <disabledPackageSources>
    <clear />
    <add key="legacy" value="true" />
  </disabledPackageSources>
  <auditSources>
    <clear />
    <add key="security" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </auditSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="decoy">
      <package pattern="Decoy.*" />
    </packageSource>
    <packageSource key="selected">
      <package pattern="Newtonsoft.*" />
    </packageSource>
    <packageSource key="legacy">
      <package pattern="Legacy.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
