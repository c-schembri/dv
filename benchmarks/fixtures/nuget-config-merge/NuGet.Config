<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <clear />
    <add key="globalPackagesFolder" value="%DV_CONFIG_PACKAGES%" />
  </config>
  <packageSources>
    <clear />
    <add key="selected" value="%DV_CONFIG_SOURCE%" protocolVersion="3" />
    <add key="disabled" value="https://disabled.example.test/v3/index.json" protocolVersion="3" />
    <remove key="ghost" />
  </packageSources>
  <disabledPackageSources>
    <clear />
    <add key="disabled" value="true" />
    <remove key="ghost" />
  </disabledPackageSources>
</configuration>
