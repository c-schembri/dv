<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="decoy" value="http://127.0.0.1:9/v3/index.json" protocolVersion="3" allowInsecureConnections="true" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="decoy">
      <package pattern="Mapped.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
