<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
    <add key="final" value="policy/fallback-final" />
  </fallbackPackageFolders>
  <config>
    <add key="globalPackagesFolder" value="policy/config-global" />
    <add key="signatureValidationMode" value="accept" />
    <add key="http_proxy" value="http://127.0.0.1:9" />
    <add key="no_proxy" value="api.nuget.org,localhost" />
  </config>
</configuration>
