<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <fallbackPackageFolders>
    <add key="machine" value="machine-fallback" />
  </fallbackPackageFolders>
  <config>
    <add key="globalPackagesFolder" value="machine-global" />
    <add key="signatureValidationMode" value="require" />
    <add key="http_proxy" value="http://stale.proxy.invalid:8080" />
  </config>
</configuration>
