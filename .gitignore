/target/
/.idea/
/.vscode/
*.user
*.suo

# Benchmark output is machine-specific evidence, not source.
/benchmarks/results/*
!/benchmarks/results/.gitkeep

# Benchmark setup derives these caches and build outputs from source fixtures.
/benchmarks/fixtures/**/bin/
/benchmarks/fixtures/**/obj/
/benchmarks/fixtures/**/.packages/
/benchmarks/fixtures/**/.dv-packages/
/benchmarks/fixtures/**/.oracle-packages/
/benchmarks/fixtures/**/dv.lock.json
/benchmarks/fixtures/**/packages.lock.json
/benchmarks/fixtures/nuget-storage-policy/.seed/
/benchmarks/fixtures/nuget-storage-policy/policy/
/benchmarks/fixtures/nuget-storage-policy/dv.lock.json
/benchmarks/fixtures/nuget-storage-policy/packages.lock.json
/benchmarks/fixtures/nuget-cli-overrides/policy/
/benchmarks/fixtures/nuget-cli-overrides/dv.lock.json
/benchmarks/fixtures/nuget-cli-overrides/packages.lock.json
/benchmarks/fixtures/nuget-local-sources/.packages/
/benchmarks/fixtures/nuget-local-sources/.seed/
/benchmarks/fixtures/nuget-local-sources/feeds/
/benchmarks/fixtures/nuget-local-sources/dv.lock.json
/benchmarks/fixtures/nuget-service-index/.http-cache/
